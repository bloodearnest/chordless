{
  "name": "chordless",
  "version": "1.0.0",
  "description": "Worship setlist management app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "deploy": "vite build && wrangler deploy --config dist/chordless/wrangler.json",
    "test:node": "node --test \"tests/*.node.test.{js,ts}\"",
    "test:web": "web-test-runner --config web-test-runner.config.js",
    "test:browser": "playwright test",
    "test:browser:ui": "playwright test --ui",
    "test:browser:headed": "playwright test --headed",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@lit/context": "^1.1.6",
    "@lit/reactive-element": "^2.1.2",
    "@lit/task": "^1.0.3",
    "jose": "^6.2.12",
    "lit": "^3.3.3",
    "lit-element": "^4.2.2",
    "lit-html": "^3.3.3",
    "oauth4webapi": "^3.8.8",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@open-wc/testing": "^5.0.0",
    "@playwright/test": "^1.64.0",
    "@types/google.accounts": "^0.0.18",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-mocha": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "globals": "^17.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "rollup-plugin-inject": "npm:@rollup/plugin-inject@^5.0.5",
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.5.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
