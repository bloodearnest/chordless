# The DEV Google Cloud project (infra/google-dev/, docs/ENVIRONMENTS.md): `npm run dev` and the tests.
# Public identifiers, not secrets. The matching client secret and keys are in .dev.vars.
VITE_GOOGLE_CLIENT_ID=697300620394-t82on3enupiiknemdb2r70i84vejs8gp.apps.googleusercontent.com
VITE_PICKER_APP_ID=697300620394
# The folder in My Drive that the space folders go in (the dev app's own, so it is never mistaken for
# the production app's `Chordless`: under drive.file each app sees only its own files)
VITE_DRIVE_ROOT_FOLDER=Chordless-dev
