{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // Tests need not annotate every helper parameter and `let`; the rest of strict (null safety,
    // the app's types where the tests call it) applies. See docs/TESTING.md.
    "noImplicitAny": false,
    "types": ["mocha", "google.accounts"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo"
  },
  // The browser unit tests (Web Test Runner)
  "include": [
    "tests/*.test.*",
    "tests/drive/*.drive.test.*",
    "src/env.d.ts",
    "tests/fake-drive.*",
    "tests/test-helpers.*"
  ],
  "exclude": ["tests/*.node.test.*", "tests/drive/node-side.*"]
}
