{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // Tests are checked for the app's API (names, arguments, return types), not for null safety
    // or annotations: they use partial fakes and loosely shaped fixtures on purpose
    "strict": false,
    "types": ["mocha", "google.accounts"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo"
  },
  // The browser unit tests (Web Test Runner)
  "include": ["tests/*.test.*", "tests/fake-drive.*", "tests/test-helpers.*"],
  "exclude": ["tests/*.node.test.*"]
}
