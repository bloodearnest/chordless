language js

// Moving around the app goes through the router (navigation.js: goTo), so that the
// shell, and the media player in it, are not thrown away by a page load. The few
// places that must reload say why, with a biome-ignore.
or {
  `$loc.href = $_` where {
    $loc <: or {
      `location`,
      `window.location`,
      `document.location`
    },
    register_diagnostic(span=$loc, message="Full page navigation: use goTo() (navigation.js) instead of assigning location.href", severity="error")
  },
  `$loc.$method($...)` where {
    $loc <: or {
      `location`,
      `window.location`,
      `document.location`
    },
    $method <: or {
      `assign`,
      `replace`,
      `reload`
    },
    register_diagnostic(span=$loc, message="Full page navigation: use goTo() (navigation.js) instead of location.assign/replace/reload", severity="error")
  },
  // The URL says where you are (/setlist/<id>/song/<n>), not its #hash
  `$loc.hash` where {
    $loc <: or {
      `location`,
      `window.location`,
      `document.location`
    },
    register_diagnostic(span=$loc, message="Routes are paths, not #hashes: see router.js", severity="error")
  },
  `$loc.hash = $_` where {
    $loc <: or {
      `location`,
      `window.location`,
      `document.location`
    },
    register_diagnostic(span=$loc, message="Routes are paths, not #hashes: see router.js", severity="error")
  }
}
