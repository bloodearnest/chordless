{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["google.accounts"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"],
  // The playgrounds use absolute URLs (/js/...), and the service worker has its own project
  "exclude": ["src/dev", "src/service-worker.*"]
}
