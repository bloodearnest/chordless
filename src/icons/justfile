# Generate both light and dark SVG favicons from transparent base
# Both have transparent backgrounds, only difference is symbol color:
# Light mode: #2980b9 (darker blue for visibility on light backgrounds)
# Dark mode: #3498db (brighter blue for visibility on dark backgrounds)
generate-svg:
    ./generate-favicons.sh

# Generate the apple-touch-icon (iOS PWA) from base with dark background
# Uses ImageMagick convert since favicon-base.svg uses paths (no embedded fonts)
# -background sets the background color, -density renders at high DPI for crisp output
generate-apple-icon:
    convert -density 300 -background "#2c3e50" favicon-base.svg -resize 192x192 apple-touch-icon.png

# Generate 512x512 icon for PWA manifest with dark background
# Higher density for larger size to avoid blurriness
generate-icon-512:
    convert -density 600 -background "#2c3e50" favicon-base.svg -resize 512x512 icon-512.png

# Generate all PWA icons
generate-pwa-icons: generate-apple-icon generate-icon-512

# Generate all favicon variants at once
generate-all: generate-svg generate-pwa-icons

