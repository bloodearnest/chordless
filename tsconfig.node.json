{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  // Code that runs in Node: the build, the Playwright tests (which also reach into the page,
  // hence DOM), the node tests and the config files
  "include": [
    "*.config.*",
    "vite-plugins",
    "tests/*.node.test.*",
    "tests/*.playwright.*",
    "tests/fixtures.*"
  ]
}
