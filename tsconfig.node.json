{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // Tests need not annotate every helper parameter and `let`; the rest of strict (null safety,
    // the app's types where the tests call it) applies. See docs/TESTING.md.
    "noImplicitAny": false,
    "types": ["node", "google.accounts"],
    // The tests import the app's modules inside the page, by the URLs it serves them at
    "paths": { "/js/*": ["./src/js/*"] },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  // Code that runs in Node: the build, the Playwright tests (which also reach into the page,
  // hence DOM), the node tests and the config files
  "include": [
    "*.config.*",
    "vite-plugins",
    "scripts/*.ts",
    "src/env.d.ts",
    "tests/drive/node-side.*",
    "tests/*.node.test.*",
    "tests/*.playwright.*",
    "tests/fixtures.*",
    "tests/*.d.ts"
  ]
}
