// Renovate keeps up to date what Dependabot cannot (docs/CI.md): the tools pinned in mise.toml (it has
// no mise support), and ZAP's image, pinned by digest in scripts/zap-baseline.sh. Only those: npm
// packages, actions and Terraform providers stay Dependabot's (.github/dependabot.yml), so no
// manager but these is on.
// - One pull request a week (Mondays, London time) of every tool with a new version, each at least a
//   week old, as Dependabot's are. Merged by itself once its checks pass, as Dependabot's are.
// - A major version is its own pull request and is not merged by itself: Node 22 to 24 is a decision.
//   gcloud numbers every release as a major (589.0.0, 590.0.0), so it is not held back by that.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  enabledManagers: ["mise", "custom.regex"],
  customManagers: [
    {
      // IMAGE=ghcr.io/zaproxy/zaproxy@sha256:<digest> # <tag>
      customType: "regex",
      managerFilePatterns: ["/^scripts/zap-baseline\\.sh$/"],
      matchStrings: ["IMAGE=(?<depName>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+) # (?<currentValue>\\S+)"],
      datasourceTemplate: "docker",
    },
  ],
  timezone: "Europe/London",
  schedule: ["before 7am on Monday"],
  minimumReleaseAge: "7 days",
  dependencyDashboard: false,
  commitMessagePrefix: "tools:",
  automerge: true,
  platformAutomerge: true,
  automergeStrategy: "rebase",
  packageRules: [
    {
      matchManagers: ["mise"],
      groupName: "mise tools",
    },
    {
      matchManagers: ["mise"],
      matchUpdateTypes: ["major"],
      groupName: "mise tools (major versions)",
      automerge: false,
    },
    {
      matchManagers: ["mise"],
      matchPackageNames: ["gcloud"],
      groupName: "mise tools",
      automerge: true,
    },
    {
      // Its own pull request, read before it merges: a new ZAP can make the weekly scan of
      // chordless.app fail (.zap/rules.tsv), which no pull request's checks would show
      matchManagers: ["custom.regex"],
      matchPackageNames: ["ghcr.io/zaproxy/zaproxy"],
      automerge: false,
    },
  ],
}
