# Read by Cloudflare's static assets: these headers go on every file the app serves.
# (See docs/BUILD.md. The dev server does not send them.)
#
# The policy is enforced: the browser blocks anything outside it, and says so in the console
# ("Refused to ..."). To trial a change without blocking, send it as
# Content-Security-Policy-Report-Only instead, and watch the console.
#
# accounts.google.com: Google Identity Services (the sign-in script, its styles and frame).
# www.googleapis.com: the Drive API. *.googleusercontent.com: the Google account photo.
# apis.google.com, www.gstatic.com, docs.google.com: the Google Picker (folder choice for a team
# space; its page is Google's, in a frame). Not yet seen running: watch the console for "Refused to".
# songselect.ccli.com: its icon in the song info dialog.
# style-src-attr 'unsafe-inline' allows style="" attributes only: no <style> elements.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client https://apis.google.com https://www.gstatic.com; style-src 'self' https://accounts.google.com/gsi/style; style-src-attr 'unsafe-inline'; connect-src 'self' https://www.googleapis.com https://accounts.google.com/gsi/ https://*.googleusercontent.com; img-src 'self' data: https://*.googleusercontent.com https://songselect.ccli.com; media-src 'self' blob:; frame-src https://accounts.google.com/gsi/ https://docs.google.com https://content.googleapis.com; worker-src 'self'; manifest-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
# Hashed files: the name changes when the content does, so they never need revalidating
/assets/*
  Cache-Control: public, max-age=31536000, immutable
