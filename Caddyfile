{
    admin off
    auto_https off
}

# HTTP server (also used by Tailscale Funnel)
:8080 {
    root * .
    encode zstd gzip
    handle /oauth/* {
        reverse_proxy http://localhost:8787
    }
    handle /session/* {
        reverse_proxy http://localhost:8787
    }
    handle /api/* {
        reverse_proxy http://localhost:8787
    }
    file_server browse {
        try_files {path} {path}.html
    }
}

# HTTPS server (localhost, chordless.dev, Tailscale)
https://localhost:8443, https://127.0.0.1:8443, https://casey.tail030f3.ts.net:8443, https://chordless.dev {
    root * .
    encode zstd gzip
    tls certs/dev.crt certs/dev.key
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
    # Proxy auth and API routes to local wrangler dev server
    handle /oauth/* {
        reverse_proxy http://localhost:8787
    }
    handle /session/* {
        reverse_proxy http://localhost:8787
    }
    handle /api/* {
        reverse_proxy http://localhost:8787
    }
    file_server browse {
        try_files {path} {path}.html
    }
}
